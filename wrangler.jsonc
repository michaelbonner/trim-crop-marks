{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trim-crop-marks",
  "compatibility_date": "2026-10-06",
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // Wrangler requires a `previews` block for any command that creates a
  // Preview deployment (the default Workers Builds preview command is
  // `npx wrangler preview`). The block can be empty: this Worker is
  // assets-only, so there are no bindings or vars to override for previews.
  // Assets and compatibility settings stay at the top level.
  "previews": {},
}
